# 운영(VM) 설정 — 복사해서 .env.prod 로 만들고 값을 채우세요. .env.prod 는 절대 커밋하지 마세요 (.gitignore 에 있어요)
#   cp deploy/.env.prod.example deploy/.env.prod

# 서비스 도메인 (DNS A 레코드가 이 VM 의 공인 IP 를 가리켜야 해요)
DOMAIN=chickchicken.example.com
# Let's Encrypt 인증서 만료 알림을 받을 메일
ACME_EMAIL=you@example.com

# DB 비밀번호 — 반드시 바꾸세요. 예: openssl rand -hex 24  (setup-vm.sh 는 비어 있으면 자동 생성해요)
POSTGRES_PASSWORD=

# 결제: 비워두면 모의 결제. 토스 테스트 키(test_ 로 시작)를 넣으면 토스페이먼츠 테스트 모드
PAYMENT_PROVIDER=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 데스크톱 클라이언트의 공개 조회 CORS 허용 출처 (* = 모두, 조회 전용이라 기본 * 로 둬도 안전)
CORS_PUBLIC_ORIGINS=*
INSTANCE_ID=oci-vm
