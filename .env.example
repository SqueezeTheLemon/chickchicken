# 서버 포트
PORT=3000
# 업로드 영상, 라이브 HLS 조각이 저장되는 폴더 (여러 인스턴스면 공유 볼륨)
DATA_DIR=./data

# ---- 5단계: 공용 DB (PostgreSQL) ----
# 로컬 개발: npm run db:up (docker compose, 5433 포트) 후 아래 주소 그대로
# devpassword 는 로컬 개발용 기본값이에요. 바꾸려면 POSTGRES_PASSWORD 와 함께 바꾸세요
DATABASE_URL=postgres://chickchicken:devpassword@localhost:5433/chickchicken
POSTGRES_PASSWORD=devpassword
# 인스턴스 이름 (비우면 호스트 이름, 쿠버네티스에선 Pod 이름)
INSTANCE_ID=
# 업로드 최대 크기 (MB)
MAX_UPLOAD_MB=500

# ---- 2단계: 라이브 ----
# ffmpeg 실행 파일 경로 (PATH 에 있으면 비워두세요)
FFMPEG_PATH=
# HLS 조각 길이(초). 짧을수록 지연이 줄고 요청이 늘어요
HLS_SEGMENT_SECONDS=2
# 휴대폰 카메라는 HTTPS 에서만 동작해요. mkcert 로 만든 인증서 경로를 넣으면 HTTPS 로 실행돼요
# (터널(cloudflared 등)을 쓸 거면 비워두세요)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# ---- 3단계: 로그인 ----
# 로그인 유지 시간(시간). 기본 7일
SESSION_TTL_HOURS=168
# HTTPS 로 서비스(터널 포함)할 때 true → 세션 쿠키에 Secure 플래그
COOKIE_SECURE=false

# ---- 4단계: 도네이션 결제 ----
# toss = 토스페이먼츠 테스트 모드, mock = 로컬 모의 결제 (비워두면 토스 키가 있을 때 toss, 없으면 mock)
PAYMENT_PROVIDER=
# 토스페이먼츠 개발자센터 > API 키 > "API 개별 연동 키" 의 테스트 키 (test_ 로 시작하는 키만 허용)
# ⚠️ 실제 키 값은 .env 에만 넣고 절대 커밋하지 마세요
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---- 6단계: 배포 ----
# 공개 주소 (/api/health 에 표시). 운영(VM)은 deploy/.env.prod 의 DOMAIN 으로 자동 설정돼요
PUBLIC_BASE_URL=
# 앞단 리버스 프록시 단계 수 (Caddy 뒤 = 1)
TRUST_PROXY=1
# 데스크톱 앱 등 다른 출처에 공개 조회(GET)만 허용할 출처 (쉼표 구분, * = 모두)
CORS_PUBLIC_ORIGINS=*
