# 서버 포트
PORT=3000
# DB 파일, 업로드 영상, 라이브 HLS 조각이 저장되는 폴더 (상대경로는 프로젝트 루트 기준)
DATA_DIR=./data
# 업로드 최대 크기 (MB)
MAX_UPLOAD_MB=500

# ---- 2단계: 라이브 ----
# ffmpeg 실행 파일 경로 (PATH 에 있으면 비워두세요)
FFMPEG_PATH=
# HLS 조각 길이(초). 짧을수록 지연이 줄고 요청이 늘어요
HLS_SEGMENT_SECONDS=2
# 휴대폰 카메라는 HTTPS 에서만 동작해요. mkcert 로 만든 인증서 경로를 넣으면 HTTPS 로 실행돼요
# (터널(cloudflared 등)을 쓸 거면 비워두세요)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# ---- 3단계: 로그인 ----
# 로그인 유지 시간(시간). 기본 7일
SESSION_TTL_HOURS=168
# HTTPS 로 서비스(터널 포함)할 때 true → 세션 쿠키에 Secure 플래그
COOKIE_SECURE=false
